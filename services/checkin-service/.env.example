PORT=4001
NODE_ENV=development
SERVICE_NAME=checkin-service
LOG_LEVEL=info
DATABASE_URL=postgres://checkin_user:checkin_pass@localhost:5433/checkin_db
DB_SSL=false
SEED_DEMO_DATA=true
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
ALERT_SERVICE_URL=http://localhost:4002
CLINIC_SERVICE_URL=http://localhost:4003
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=10
MISSED_CHECKIN_ENABLED=true
MISSED_CHECKIN_HOURS=26
MISSED_CHECKIN_SCAN_MINUTES=30
# Optional clinical threshold overrides (have your partner RHU physician approve values)
# ANOMALY_CRISIS_SYSTOLIC=180
# ANOMALY_CRISIS_DIASTOLIC=120
