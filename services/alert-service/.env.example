PORT=4002
NODE_ENV=development
SERVICE_NAME=alert-service
LOG_LEVEL=info
DATABASE_URL=postgres://alert_user:alert_pass@localhost:5434/alert_db
DB_SSL=false
SEED_DEMO_DATA=true
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
CHECKIN_SERVICE_URL=http://localhost:4001
CLINIC_SERVICE_URL=http://localhost:4003

# ---- OpenWeatherMap (https://home.openweathermap.org/api_keys) ----
OPENWEATHER_API_KEY=
OPENWEATHER_ONECALL_ENABLED=false
WEATHER_POLL_ENABLED=true
WEATHER_POLL_INTERVAL_MINUTES=30
WEATHER_CACHE_TTL_MINUTES=60
WEATHER_STALE_MAX_HOURS=24
HEAT_INDEX_THRESHOLD_C=40
STORM_WIND_MS=17.2
HEAT_RISK_CONDITIONS=hypertension,cardiovascular,heart_disease,diabetes,kidney_disease,copd

# ---- Twilio Programmable Messaging (https://console.twilio.com) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public gateway URL Twilio posts delivery receipts to, e.g. https://api.example.com/webhooks/twilio/status
TWILIO_STATUS_CALLBACK_URL=
# Public gateway URL for incoming caregiver SMS check-ins, e.g. https://api.example.com/webhooks/twilio/inbound
TWILIO_INBOUND_WEBHOOK_URL=
TWILIO_VALIDATE_WEBHOOK=true
# true = log SMS instead of sending (no credit used). Auto-on in development when Twilio is not configured.
SMS_DRY_RUN=true
SMS_MAX_ATTEMPTS=5
SMS_BACKOFF_MS=5000
SMS_RATE_PER_SEC=1

# ---- SMS provider: textbee | twilio | none (empty = auto) ----
SMS_PROVIDER=
# ---- TextBee (https://textbee.dev) - Android phone as SMS gateway ----
# POST {TEXTBEE_BASE_URL}/gateway/send-sms  headers: x-api-key, Content-Type: application/json
# body: { deviceId, recipients: [..], message }.  Never commit real values.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_SIM_SUBSCRIPTION_ID=
TEXTBEE_TIMEOUT_MS=10000
# Webhook (delivery receipts + inbound SMS check-ins): https://<public-gateway>/webhooks/textbee
TEXTBEE_WEBHOOK_SECRET=
TEXTBEE_VALIDATE_WEBHOOK=true
# Only these numbers get REAL texts (others are simulated). Required outside production.
SMS_RECIPIENT_ALLOWLIST=
SMS_DAILY_LIMIT=40

# BullMQ durable queue (leave empty for in-memory queue in local dev)
REDIS_URL=redis://localhost:6379
