    {
      "name": "2. Functional - Daily Check-In Logger",
      "item": [
        {
          "name": "POST /api/checkins - normal vitals (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const c = pm.response.json().checkin;",
                  "pm.test(\"Schema: id, vitals, severity\", () => { pm.expect(c.id).to.be.a(\"string\"); pm.expect(c.vitals.systolic).to.eql(126); });",
                  "pm.test(\"No anomalies for normal vitals\", () => pm.expect(c.severity).to.eql(\"none\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
