                  "pm.test(\"Anomaly detected as critical\", () => { pm.expect(j.checkin.severity).to.eql(\"critical\"); pm.expect(j.eventId).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"e2eCheckinId\", j.checkin.id);"
