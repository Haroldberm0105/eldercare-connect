      "name": "0. Auth (OAuth 2.0)",
      "item": [
        {
          "name": "Login - caregiver.maria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test(\"Returns bearer access token\", () => { pm.expect(j.token_type).to.eql(\"Bearer\"); pm.expect(j.access_token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"caregiverToken\", j.access_token);",
                  "if (\"caregiverToken\" === \"nurseToken\") pm.collectionVariables.set(\"refreshToken\", j.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
